# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Node
node_modules/
# The deleted web app, in checkouts that still have it on disk
frontend/

# Secrets — API keys and database URLs live in .env, never in the repository
.env
.env.*
!.env.example

# Runtime data: uploaded documents and generated .apkg files.
# `.local/` is the local dev volume — it holds real uploaded material, which is
# other people's copyrighted course notes and must never reach a repository.
.local/
data/
*.db
*.db-wal
*.db-shm
*.apkg

# Local editor and agent settings, which are per-machine rather than
# per-project.
.claude/settings.local.json

# OS
.DS_Store
.claude/launch.json
